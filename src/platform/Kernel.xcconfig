ARCHS = x86_64
ALWAYS_SEARCH_USER_PATHS = NO
VALID_ARCHS = x86_64
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
CLANG_CXX_LANGUAGE_STANDARD = c++14
CLANG_CXX_LIBRARY =
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_IDENTITY =
GCC_ENABLE_CPP_EXCEPTIONS = NO
GCC_ENABLE_CPP_RTTI = NO
GCC_ENABLE_FLOATING_POINT_LIBRARY_CALLS = NO
GCC_ENABLE_KERNEL_DEVELOPMENT = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
// Never compile against downloaded research headers. Use only Apple SDK/KDK.
KERNEL_EXTENSION_HEADER_SEARCH_PATHS = $(SDKROOT)/System/Library/Frameworks/Kernel.framework/Headers
KERNEL_FRAMEWORK_HEADERS = $(SDKROOT)/System/Library/Frameworks/Kernel.framework/Headers
HEADER_SEARCH_PATHS = $(PROJECT_DIR)/..
LIBRARY_SEARCH_PATHS =
OTHER_CFLAGS = -Wall -Wextra -Werror -Wno-unused-parameter -Wno-deprecated-declarations -Wno-ossharedptr-misuse -fno-builtin -fno-asynchronous-unwind-tables -nostdlib
OTHER_LDFLAGS = -static
// Required by Apple IO80211 request/ABI headers; compiler-owned, not a source macro.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) PRODUCT_NAME=SimpleATH MODULE_VERSION=$(MODULE_VERSION) __IO80211_TARGET=10
MODULE_NAME = dev.alberto.SimpleATH
MODULE_VERSION = 0.1.0
MODULE_START = SimpleATH_kern_start
MODULE_STOP = SimpleATH_kern_stop
PRODUCT_NAME = SimpleATH
PRODUCT_BUNDLE_IDENTIFIER = $(MODULE_NAME)
INFOPLIST_FILE = src/Info.plist
GENERATE_INFOPLIST_FILE = NO
WRAPPER_EXTENSION = kext
COPY_PHASE_STRIP = NO
DEPLOYMENT_POSTPROCESSING = NO
STRIP_INSTALLED_PRODUCT = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
