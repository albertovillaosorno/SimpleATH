// Module: Offline regression cases for route test.

#include "Patcher.hpp"
#include <cstdio>
#include <cstring>

extern "C" int copyin(uintptr_t, void *, size_t)
{
    return -1;
}

extern "C" int copyout(const void *, uintptr_t, size_t)
{
    return -1;
}

extern "C" void IOLog(const char *, ...)
{
}

extern "C" int version_major = 26;
bool simpleATHDebug = false;
using Function = int (*)();

int replacement()
{
    return 0;
}

int original()
{
    return 1;
}

int main()
{
    uint8_t memory[512] {};
    for (size_t i = 0; i < sizeof(memory); ++i)
        memory[i] = 0x90;
    uint8_t originalMemory[sizeof(memory)];
    memcpy(originalMemory, memory, sizeof(memory));
    ath::RoutePrefix routePrefixes[] = {{32, 14}, {80, 14}};
    ath::Symbol symbols[] = {{"alpha", 32}, {"beta", 80}};
    ath::Payload payload {};
    payload.size = 200;
    payload.mappedSize = sizeof(memory);
    payload.stubOffset = 256;
    payload.stubSize = 128;
    payload.routes = routePrefixes;
    payload.routeCount = 2;
    payload.symbols = symbols;
    payload.symbolCount = 2;
    ath::LinkedImage image {
        &payload, memory, reinterpret_cast<uintptr_t>(memory), 0, false, true};
    KernelPatcher patcher(image);
    Function savedA = &original;
    Function savedB = &original;
    KernelPatcher::RouteRequest missing[] = {{"alpha", &replacement, savedA},
                                             {"missing", &replacement, savedB}};
    if (patcher.routeMultipleLong(0, missing, image.address,
                                  payload.mappedSize))
        return 10;
    if (std::memcmp(originalMemory, memory, sizeof(memory)) != 0 ||
        image.stubUsed != 0 || savedA != &original || savedB != &original)
    {
        std::fprintf(stderr, "partial mutation on invalid second route\n");
        return 11;
    }
    // Reject invalid stored bounds, duplicate/overlapping hook ranges and
    // insufficient aggregate stub capacity before touching the first route.
    KernelPatcher::RouteRequest valid[] = {{"alpha", &replacement, savedA},
                                           {"beta", &replacement, savedB}};
    // Check that the templated native function-pointer slot is preserved
    // byte-for-byte, not decoded as an object or aliased as uintptr_t.
    Function replacementPointer = &replacement;
    uintptr_t replacementBits = 0;
    static_assert(sizeof(replacementPointer) == sizeof(replacementBits),
                  "x86_64 function pointer width mismatch");
    std::memcpy(&replacementBits, &replacementPointer, sizeof(replacementBits));
    if (valid[0].target() != replacementBits ||
        valid[0].original() != static_cast<void *>(&savedA) ||
        valid[1].original() != static_cast<void *>(&savedB))
        return 20;
    Function shared = &original;
    KernelPatcher::RouteRequest reusedOutput[] = {
        {"alpha", &replacement, shared}, {"beta", &replacement, shared}};
    if (patcher.routeMultipleLong(0, reusedOutput, image.address,
                                  payload.mappedSize) ||
        shared != &original)
        return 19;
    image.payload = nullptr;
    if (patcher.routeMultipleLong(0, valid, image.address, payload.mappedSize))
        return 14;
    image.payload = &payload;
    payload.stubSize = 300;
    if (patcher.routeMultipleLong(0, valid, image.address, payload.mappedSize))
        return 15;
    payload.stubSize = 32;
    if (patcher.routeMultipleLong(0, valid, image.address, payload.mappedSize))
        return 16;
    payload.stubSize = 128;
    routePrefixes[1].offset = 40;
    symbols[1].offset = 40;
    if (patcher.routeMultipleLong(0, valid, image.address, payload.mappedSize))
        return 17;
    routePrefixes[1].offset = 80;
    symbols[1].offset = 80;
    if (std::memcmp(originalMemory, memory, sizeof(memory)) != 0 ||
        image.stubUsed != 0 || savedA != &original || savedB != &original)
        return 18;
    if (!patcher.routeMultipleLong(0, valid, image.address, payload.mappedSize))
        return 12;
    if (image.stubUsed != 64 || savedA == &original || savedB == &original ||
        memory[32] != 0xFF || memory[80] != 0xFF)
        return 13;
    std::puts("PASS isolated synthetic native-patcher route staging");
    return 0;
}
